{
  "name": "nicolas-center-elite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "vercel-build": "node scripts/migrate.mjs && node scripts/setup-storage.mjs && next build",
    "start": "next start -p 3000",
    "lint": "eslint src tests bridge scripts --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "format": "prettier --write .",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "node scripts/migrate.mjs --reset",
    "db:seed": "tsx scripts/seed-demo.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:api": "vitest run tests/api",
    "test:e2e": "playwright test",
    "bridge": "node bridge/bridge.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:check": "node scripts/backup.mjs --restore-check",
    "legal:packet": "tsx scripts/legal-packet.ts",
    "trace": "node scripts/trace.mjs"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@supabase/supabase-js": "^2.117.3",
    "dicom-parser": "^1.8.21",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "next": "^15.5.27",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swr": "^2.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
