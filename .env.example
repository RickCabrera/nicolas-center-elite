# ───────────────────────── Nicolas Center Elite · variables de entorno ─────────────────────────
# Copia este archivo a .env.local para desarrollo. En Vercel se capturan en Settings → Environment Variables.
# La app valida estas variables al arrancar y dice por nombre cuál falta.

# [OBLIGATORIA] Cadena de conexión a Postgres.
#   Supabase: Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
DATABASE_URL=postgres://nce_admin:dev@127.0.0.1:54329/nce_dev

# [RECOMENDADA en producción] Conexión DIRECTA para migraciones y respaldos (no pasa por el pooler).
#   Supabase: Project Settings → Database → Connection string → "Direct connection" (puerto 5432).
#   Si falta, las migraciones usan DATABASE_URL.
DIRECT_DATABASE_URL=

# [OBLIGATORIA] Secreto para firmar sesiones. 48+ caracteres aleatorios.  Genera: openssl rand -base64 48
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-48-caracteres

# [OBLIGATORIA] Llave para cifrar las credenciales del lector Hikvision. Genera: openssl rand -base64 32
ENCRYPTION_KEY=cambia-esto-por-otra-llave-aleatoria-distinta

# [OBLIGATORIA] URL pública de la app, sin diagonal final. Se usa en correos, passkeys y en la URL del webhook.
APP_URL=http://localhost:3000

# Entorno: development | staging | production
APP_ENV=development

# [OBLIGATORIA en producción] Token de un solo uso para crear la cuenta del dueño en /setup.
SETUP_TOKEN=

# [OBLIGATORIA en producción] Secreto de la tarea programada diaria (Vercel Cron lo envía como Bearer).
CRON_SECRET=

# ── Archivos (estudios) ────────────────────────────────────────────────────────────────────────
# local    = disco del servidor (solo desarrollo y pruebas)
# supabase = bucket privado de Supabase Storage (producción)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
# Supabase: Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=estudios

# ── Correo (invitaciones y recuperación de contraseña) ─────────────────────────────────────────
# Sin llave, los correos se guardan en la tabla email_outbox y se muestran en la consola.
RESEND_API_KEY=
EMAIL_FROM=Nicolas Center Elite <no-reply@example.com>

# ── Cobro en línea (Stripe: tarjeta y OXXO) ───────────────────────────────────────────────────
# Sin llave, "Cobrar en línea" avisa que falta conectar Stripe. sk_test_ = pruebas, sk_live_ = cobra de verdad.
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint https://<dominio>/api/webhooks/stripe → Signing secret.
STRIPE_WEBHOOK_SECRET=

# ── Facturación CFDI 4.0 (Facturapi) ───────────────────────────────────────────────────────────
# Llave secreta de la organización en Facturapi. sk_test_ timbra sin validez ante el SAT.
FACTURAPI_KEY=

# ── Opcionales ────────────────────────────────────────────────────────────────────────────────
# Habilita el simulador de lecturas de huella. Nunca se activa con APP_ENV=production.
ENABLE_SIMULATOR=true
